# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where contact-form messages are delivered (defaults to the email in data/content.ts).
# While using the onboarding sender below, Resend only delivers to your own Resend account email.
CONTACT_TO_EMAIL=

# Sender. Use onboarding@resend.dev for testing, or an address on a domain you verified in Resend.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
